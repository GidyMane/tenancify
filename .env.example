# Copy to .env.local (which git ignores) and fill in. Never put secrets in .env — it is not ignored.

# Kinde — Settings → Applications → your back-end web app.
# In Kinde also set: Allowed callback URL  = <KINDE_SITE_URL>/api/auth/kinde_callback
#                    Allowed logout redirect URL = <KINDE_SITE_URL>
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://<your-subdomain>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000

# Where the Renters API runs. The app forwards /api/v1/* there and adds the signed-in user's token.
# The API's own KINDE_DOMAIN must equal KINDE_ISSUER_URL exactly (https, no trailing slash).
API_PROXY_TARGET=http://localhost:5000/api/v1
